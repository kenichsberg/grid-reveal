# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Second VM: postgres://griduser:pass@10.0.0.x:5432/griddb?sslmode=require
# Same host: postgres://griduser:pass@localhost:5432/griddb
# Managed:   postgres://user:pass@host.provider.tld/griddb?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/grid_reveal

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
BIND_ADDR=0.0.0.0:8080

# Domain the session cookie is scoped to. Must be a registrable domain that
# covers BOTH the web and API hosts, e.g. ".example.com" for app.example.com
# and api.example.com. Leave empty for local development (host-only cookie).
COOKIE_DOMAIN=

# Set to false ONLY for local http development; the cookie's Secure attribute
# is required in production.
COOKIE_SECURE=true

# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# How long a session lasts before it must be re-established.
SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Used only when no administrator account exists yet. Changing these later has
# no effect on an existing account.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-deploying

# ---------------------------------------------------------------------------
# Object storage (Cloudflare R2, S3-compatible)
# ---------------------------------------------------------------------------
# Not read by the API. It is here only because the endpoint below is built
# from it; your Cloudflare account ID, from the dashboard URL.
R2_ACCOUNT_ID=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=grid-reveal-pictures

# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
#
# This one is the switch. Set it and the three variables above are required and
# pictures go to object storage; leave it empty and they go to local disk,
# which no backup covers and which does not survive the instance.
R2_ENDPOINT=
# Public base URL pictures are served from, if the bucket has a public domain.
# Leave empty to have the API stream pictures itself.
R2_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Frontend build (apps/web)
# ---------------------------------------------------------------------------
# Consumed by Vite at build time; must be reachable from the browser. The API
# never reads this — it belongs in a local .env and in the repository variable
# the deploy workflow builds with, not in the VM's .env.
PUBLIC_API_BASE_URL=http://localhost:8080
