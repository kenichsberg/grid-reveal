# Environment / secrets
.env
.env.*
!.env.example

# Rust
target/
**/*.rs.bk

# Node
node_modules/
.npm/
.pnpm-store/

# SvelteKit build output
apps/web/.svelte-kit/
apps/web/build/
apps/web/.wrangler/

# ts-rs writes here when TS_RS_EXPORT_DIR is unset, i.e. on a bare `cargo test`.
# The real output lives in apps/web; this copy is incidental.
apps/api/bindings/

# NOTE: apps/web/src/lib/api/types/ is generated by scripts/gen-types.sh but is
# deliberately committed. Cloudflare Pages builds apps/web with no Rust
# toolchain, so the contract has to be in the tree for the build to succeed.

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log
npm-debug.log*
